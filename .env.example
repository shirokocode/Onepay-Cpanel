# ==============================================================
# Salin file ini jadi ".env" lalu isi. (Semua OPSIONAL, bisa juga diatur
# lewat halaman Admin > Pterodactyl setelah login sebagai owner.)

# Port web. Di Pterodactyl otomatis pakai SERVER_PORT.
PORT=3000

# Mode start: "port" (http://domain:PORT) atau "cloudflare" (tunnel otomatis)
START_MODE=port

# Token Cloudflare Tunnel (opsional). Kosongkan = pakai link trycloudflare acak.
CF_TUNNEL_TOKEN=

# URL publik (opsional, cuma buat ditampilkan di console)
PUBLIC_URL=

# Akun OWNER pertama (dipakai saat database masih kosong).
# Kalau OWNER_PASS kosong, password acak dibuat & ditampilkan di console.
OWNER_USER=owner
OWNER_PASS=

# Nilai awal setelan Pterodactyl (bisa diubah nanti dari halaman admin)
PTERO_DOMAIN=
PTERO_PLTA=
PTERO_NEST=5
PTERO_EGG=15
PTERO_LOCATION=1
